# =====================================================================
#  Ribat — environment variables
#  Copy to `.env` and fill in. Never commit `.env`.
# =====================================================================

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (PostgreSQL: Supabase / Neon) ----------------------------
# Pooled connection used by the app at runtime.
#   Supabase: Transaction pooler (port 6543)  ·  Neon: "-pooler" host
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection used by Prisma CLI for migrations.
#   Supabase: Session/direct (port 5432)  ·  Neon: non-pooler host
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth.js -----------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"   # only needed behind some proxies
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Seed (used only by `npm run db:seed`) -----------------------------
SEED_ADMIN_EMAIL="admin@ribat.com.bd"
SEED_ADMIN_PASSWORD=""

# --- Payments: bKash Tokenized Checkout --------------------------------
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# --- Payments: Nagad ---------------------------------------------------
NAGAD_BASE_URL=""
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""

# --- Payments: SSLCommerz ----------------------------------------------
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# --- Courier: Steadfast ------------------------------------------------
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# --- Courier: Pathao ---------------------------------------------------
PATHAO_BASE_URL="https://courier-api-sandbox.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""
