// =====================================================================
//  Ribat — Prisma Schema (PostgreSQL)
//  Pillars: Storefront · Admin Dashboard · Landing Page Engine
//  Money: Decimal(12,2) in BDT. Never use Float for prices.
// =====================================================================

// Prisma 7: connection URLs no longer live here.
//  - CLI (migrate/studio) uses DIRECT_URL via prisma.config.ts
//  - Runtime uses the pooled DATABASE_URL via @prisma/adapter-pg (src/server/db.ts)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
//  ENUMS
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductType {
  SIMPLE   // has exactly one default variant
  VARIABLE // has 1..n variants built from attribute values
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeDisplay {
  SWATCH   // color circles
  BUTTON   // size pills
  DROPDOWN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum OrderSource {
  STOREFRONT
  LANDING_PAGE
  ADMIN // manual / phone orders
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum StockReason {
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN
  RESTOCK
  MANUAL_ADJUSTMENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
//  USERS & AUTH  (Auth.js / NextAuth v5 Prisma adapter compatible)
// ---------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique // BD customers often identify by phone
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // credentials login (admin/staff)
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  reviews       Review[]

  orderStatusChanges OrderStatusHistory[]
  inventoryLogs      InventoryLog[]
  landingPages       LandingPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String? // "Home", "Office"
  fullName    String
  phone       String
  division    String?
  district    String
  area        String  // thana / upazila
  addressLine String
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------
//  CATALOG
// ---------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  nameBn      String?    // Bengali display name
  description String?
  imageUrl    String?
  parentId    String?
  position    Int        @default(0)
  isActive    Boolean    @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// Marketing groupings: "Eid Collection", "New Arrivals", "Winter Edit"
model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  position    Int       @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SizeChart {
  id       String    @id @default(cuid())
  name     String    // "Men's Panjabi", "Women's Abaya"
  // { columns: ["Size","Chest","Length"], rows: [["M","40","44"], ...], note: "in inches" }
  table    Json
  imageUrl String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  type             ProductType   @default(SIMPLE)
  status           ProductStatus @default(DRAFT)
  shortDescription String?
  description      String?       @db.Text // sanitized HTML from rich-text editor
  fabricCare       String?       @db.Text
  tags             String[]
  isFeatured       Boolean       @default(false)
  nameBn           String?       // Bengali display name
  badge            String?       // "New" | "Bestseller" | "Limited" | "Eid Edit"

  // Denormalized from variants (kept in sync by service layer) for fast listing/sort
  minPrice   Decimal @default(0) @db.Decimal(12, 2)
  maxPrice   Decimal @default(0) @db.Decimal(12, 2)
  totalStock Int     @default(0)
  // Denormalized from approved reviews (kept in sync by the review service)
  ratingAvg   Decimal @default(0) @db.Decimal(2, 1)
  reviewCount Int     @default(0)

  categoryId  String?
  sizeChartId String?

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeChart    SizeChart?    @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  collections  Collection[]
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  landingPages LandingPage[]
  orderItems   OrderItem[]

  metaTitle       String?
  metaDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, isFeatured])
  @@index([categoryId])
  @@index([createdAt])
}

/// Media Library asset. Stored in Supabase Storage when configured (`url` is the public URL,
/// `data` null); otherwise the bytes live in `data` and are served from /media/<id>.<ext>.
model Media {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int // bytes
  mimeType  String
  width     Int?
  height    Int?
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Product photos in display order: position 0 is the featured image, the rest form the gallery.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  // Optional: tie image to a color so the gallery switches when the color is selected
  attributeValueId String?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]

  @@index([productId, position])
}

// Global attribute definitions: Color, Size, Material
model Attribute {
  id       String           @id @default(cuid())
  name     String           @unique
  slug     String           @unique
  display  AttributeDisplay @default(BUTTON)
  position Int              @default(0)

  values         AttributeValue[]
  variantOptions VariantOption[]
}

model AttributeValue {
  id          String  @id @default(cuid())
  attributeId String
  value       String  // "Black", "XL", "Cotton"
  slug        String
  swatchHex   String? // "#1A1A1A" for color swatches
  position    Int     @default(0)

  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantOptions VariantOption[]
  images         ProductImage[]

  @@unique([attributeId, slug])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  title          String   // "Black / XL" (generated)
  // Sorted attributeValueIds joined with "|" — guarantees no duplicate combinations
  optionKey      String   @default("default")
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2) // strike-through price
  costPrice      Decimal? @db.Decimal(12, 2) // for profit reports
  stock          Int      @default(0)
  lowStockAt     Int      @default(3)
  weightGrams    Int?
  barcode        String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  imageId        String?

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  image         ProductImage?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  options       VariantOption[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, optionKey])
  @@index([productId])
}

// One row per attribute on a variant (Color=Black, Size=XL)
model VariantOption {
  variantId        String
  attributeId      String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId]) // a variant has exactly one value per attribute
  @@index([attributeValueId])
}

model InventoryLog {
  id          String      @id @default(cuid())
  variantId   String
  change      Int         // +10 restock, -2 sale
  stockAfter  Int
  reason      StockReason
  orderId     String?
  note        String?
  createdById String?

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String?
  authorName         String
  rating             Int          // 1–5, validated in Zod
  title              String?
  body               String       @db.Text
  images             String[]
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, status])
}

// ---------------------------------------------------------------------
//  CHECKOUT, ORDERS & PAYMENTS
// ---------------------------------------------------------------------

model ShippingZone {
  id                    String   @id @default(cuid())
  name                  String   // "Inside Dhaka", "Outside Dhaka"
  fee                   Decimal  @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  estimatedDays         String?  // "1–2 days"
  districts             String[] // empty = fallback zone
  isActive              Boolean  @default(true)
  position              Int      @default(0)

  orders Order[]
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique // stored uppercase
  type           DiscountType
  value          Decimal      @db.Decimal(12, 2)
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // "RBT-100245" — human-facing

  userId String? // null = guest checkout

  // Customer snapshot (never rely on User for historical orders)
  customerName  String
  customerPhone String
  customerEmail String?
  division      String?
  district      String
  area          String
  addressLine   String
  customerNote  String?

  // Totals (snapshot at time of order)
  subtotal      Decimal @db.Decimal(12, 2)
  shippingFee   Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  currency      String  @default("BDT")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)
  source        OrderSource   @default(STOREFRONT)

  shippingZoneId String?
  couponId       String?
  couponCode     String?
  landingPageId  String?
  landingOfferId String?

  // Fulfilment
  courierName  String?
  trackingCode String?
  adminNote    String? @db.Text

  // Attribution / fraud signals
  ipAddress String?
  userAgent String?
  utm       Json?   // { source, medium, campaign, fbclid }

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingZone ShippingZone?        @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  coupon       Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  landingPage  LandingPage?         @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  history      OrderStatusHistory[]
  payments     Payment[]
  inventoryLog InventoryLog[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?
  cancelledAt DateTime?

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([userId])
  @@index([landingPageId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  // Snapshots — survive product edits/deletes
  productName  String
  variantTitle String?
  sku          String
  imageUrl     String?
  attributes   Json?   // { "Color": "Black", "Size": "XL" }
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @unique // gateway trx id (bKash trxID, SSLCommerz val_id)
  gatewayResponse Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// ---------------------------------------------------------------------
//  LANDING PAGE ENGINE (CartFlows-style)
// ---------------------------------------------------------------------

model LandingPage {
  id          String            @id @default(cuid())
  title       String            // internal name
  slug        String            @unique // ribat.com.bd/lp/<slug>
  status      LandingPageStatus @default(DRAFT)
  productId   String
  createdById String?

  // Ordered array of typed blocks, validated by a Zod discriminated union:
  // [{ id, type: "hero", props: {...} }, { type: "benefits" }, { type: "reviews" },
  //  { type: "faq" }, { type: "countdown", props: { endsAt } }, { type: "checkout" }]
  sections       Json    @default("[]")
  schemaVersion  Int     @default(1) // bump when block schema changes → migrate JSON
  theme          Json?   // { accent, font, background }

  // Checkout behaviour
  allowedVariantIds String[] // empty = all active variants
  shippingZoneIds   String[] // empty = all zones
  allowCod          Boolean  @default(true)
  allowOnline       Boolean  @default(true)
  thankYouMessage   String?

  // SEO & tracking
  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?
  facebookPixelId String?
  gtmId           String?

  // Lightweight counters (detailed analytics can come later)
  viewCount       Int @default(0)
  conversionCount Int @default(0)

  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  offers    LandingPageOffer[]
  orders    Order[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([productId])
}

// Quantity bundles shown as radio cards: "1 pc ৳1,450" / "2 pcs ৳2,600 — Save ৳300"
model LandingPageOffer {
  id             String   @id @default(cuid())
  landingPageId  String
  label          String
  quantity       Int      @default(1)
  price          Decimal  @db.Decimal(12, 2) // total for the bundle
  compareAtPrice Decimal? @db.Decimal(12, 2)
  badge          String?  // "Best Value"
  freeShipping   Boolean  @default(false)
  isDefault      Boolean  @default(false)
  position       Int      @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId])
}

// ---------------------------------------------------------------------
//  SITE SETTINGS & CONTENT
// ---------------------------------------------------------------------

model Banner {
  id             String    @id @default(cuid())
  placement      String    // "HOME_HERO", "HOME_PROMO", "CATEGORY_TOP"
  title          String?
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  ctaLabel       String?
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, position])
}

// Typed key/value store; each key has a Zod schema in code.
// Keys: "store.general", "store.announcement", "store.currency",
//       "store.social", "checkout.config", "payments.bkash", "seo.defaults"
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
